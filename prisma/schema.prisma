generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CompanyConfig {
  id                   String        @id @default(uuid())
  companyName          String
  description          String?
  capabilities         String[]
  relevantKeywords     String[]
  excludedKeywords     String[]
  excludedProducts     String[]
  minimumScore         Int           @default(7)
  lookbackDays         Int           @default(1) // 1-7 only (enforced in UI and action)
  lastSuccessfulRunAt  DateTime?     // Updated after each successful pipeline run
  rssFeeds             String[]
  customAiPrompt       String?
  notificationEmails   String[]
  isActive             Boolean       @default(true)
  registrationStatus   RegistrationStatus @default(PENDING)
  registeredAt         DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  runs                 Run[]
  opportunities        Opportunity[]
  users                User[]
  profile              CompanyProfile?

  @@map("company_configs")
}

enum RegistrationStatus {
  PENDING    // Just registered, awaiting first pipeline run
  ACTIVE     // Has run at least once
  SUSPENDED  // Admin suspended
}

model CompanyProfile {
  id                String        @id @default(uuid())
  companyId         String        @unique
  company           CompanyConfig @relation(fields: [companyId], references: [id])

  longDescription   String?       // Full company description for proposals
  founded           String?       // e.g. "2015"
  teamSize          String?       // e.g. "50-100 personas"
  caseStudies       String?       // Free text: past relevant projects
  certifications    String?       // e.g. "ISO 27001, CMMI Level 3"
  differentiators   String?       // What makes the company unique
  proposalTemplate  String?       // Custom instructions for proposal generation

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("company_profiles")
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  name          String?
  companyId     String
  company       CompanyConfig @relation(fields: [companyId], references: [id])
  role          UserRole      @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
}

model Run {
  id                    String        @id @default(uuid())
  companyId             String
  company               CompanyConfig @relation(fields: [companyId], references: [id])
  startedAt             DateTime      @default(now())
  finishedAt            DateTime?
  status                RunStatus     @default(RUNNING)
  feedsChecked          Int           @default(0)
  rawItemsFound         Int           @default(0)
  itemsAfterDateFilter  Int           @default(0)
  itemsAfterKeyword     Int           @default(0)
  itemsAfterStageGate   Int           @default(0)
  itemsSentToAi         Int           @default(0)
  opportunitiesSaved    Int           @default(0)
  errors                Json          @default("[]")
  createdAt             DateTime      @default(now())

  opportunities         Opportunity[]
  rawPublications       RawPublication[]

  @@map("runs")
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Opportunity {
  id                      String            @id @default(uuid())
  companyId               String
  company                 CompanyConfig     @relation(fields: [companyId], references: [id])
  runId                   String
  run                     Run               @relation(fields: [runId], references: [id])

  opportunityId           String            // "arce|1345906" — unique per company
  externalId              String
  sourceType              String            @default("ARCE")
  publicationDate         DateTime?
  detectedAt              DateTime          @default(now())

  organismo               String?
  title                   String
  description             String?
  url                     String
  tenderType              String?

  category                String?
  score                   Int               @default(0)
  summary                 String?
  recommendedPlay         String?

  stageGatePassed         Boolean?
  stageGateReason         String?
  aiRawOutput             Json?

  status                  OpportunityStatus @default(NUEVA)
  owner                   String?
  nextAction              String?
  nextFollowUpDate        DateTime?
  notes                   String?

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  // Enrichment fields (auto-populated after saving)
  enrichedAt              DateTime?
  closingDate             DateTime?     // "Recepción de ofertas hasta"
  openingDate             DateTime?     // "Acto de Apertura"
  prorrogasDate           DateTime?     // "Prórrogas hasta el"
  clarificationsDate      DateTime?     // "Aclaraciones hasta el"
  contactEmail            String?
  contactPhone            String?
  contactName             String?
  pliegoUrl               String?       // PDF pliego download URL
  tenderItems             Json?         // Array of { itemNumber, name, articleCode, quantity, unit }
  isElectronic            Boolean?      // "Apertura electrónica"
  urgencyAlertSentAt      DateTime?     // Last time an urgency alert email was sent

  // Market intelligence fields (populated on demand)
  marketAnalyzedAt        DateTime?
  similarAdjudications    Json?         // Historical similar tenders found
  competitorMap           Json?         // Competitors who bid on similar tenders
  priceIntelligence       Json?         // Price ranges from historical data
  marketSummary           String?       // Claude-generated market summary

  proposals               Proposal[]
  marketAnalyses          MarketAnalysis[]

  @@unique([companyId, opportunityId])
  @@map("opportunities")
}

model MarketAnalysis {
  id                String      @id @default(uuid())
  opportunityId     String
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id])
  companyId         String

  // Search parameters used
  searchKeywords    String[]
  articleCodes      String[]

  // Results
  adjudicationsFound  Int         @default(0)
  competitorsFound    Int         @default(0)

  // Structured data
  adjudications     Json          // Array of found historical adjudications
  competitors       Json          // Map of competitor -> { wins, totalAmount, organisms }
  priceRange        Json          // { min, max, average, median, currency }

  // AI summary
  summary           String?       // Claude market intelligence summary in Spanish

  analyzedAt        DateTime      @default(now())

  @@map("market_analyses")
}

model Proposal {
  id              String      @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  companyId       String

  executiveSummary       String?
  valueProposition       String?
  relevantCapabilities   String?
  clarificationQuestions String?
  nextSteps              String?
  fullText               String?   // Combined full proposal text

  generatedAt     DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("proposals")
}

enum OpportunityStatus {
  NUEVA
  REVISANDO
  RELEVANTE
  DESCARTADA
  CONTACTADA
  NO_FIT
  ARCHIVADA
}

model RawPublication {
  id             String    @id @default(uuid())
  runId          String
  run            Run       @relation(fields: [runId], references: [id])
  tenderId       String
  rawRssItem     Json
  normalized     Json?
  filterResult   String?   // "keyword_rechazado" | "exclusion_rechazado" | "stage_gate_rechazado" | "duplicado" | "enviado_a_ia" | "guardado"
  filterReason   String?
  createdAt      DateTime  @default(now())

  @@map("raw_publications")
}
